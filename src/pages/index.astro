---
import AniList from "../components/anilist.astro";
import Bio from "../components/bio.astro";
import Buttons from "../components/buttons.astro";
import Card from "../components/card.astro";
import Icons from "../components/icons.astro";
import Profile from "../components/profile.astro";
import Layout from "../layouts/layout.astro";
import "../styles/global.css";
---

<Layout>
	<main
		class="max-w-6xl mx-auto px-4 sm:px-6 pb-16 grid grid-cols-2 md:grid-cols-6 lg:grid-cols-8 gap-3 sm:gap-3 auto-rows-[minmax(100px,auto)]"
	>
		<Profile />
		<Bio />
		<AniList />
		<Icons />
		<Card
			title="Buttons"
			class="row-span-2 col-span-2 md:col-span-6 lg:col-span-8 text-ctp-text"
		>
			<Buttons />
		</Card>
		<!-- <Slippi />-->
	</main>
	<footer class="fixed bottom-4 right-4 z-50">
		<a
			href="https://github.com/Pandaptable/site"
			target="_blank"
			rel="noopener noreferrer"
			class="text-ctp-subtext0 hover:text-ctp-mauve transition-colors text-sm font-mono"
		>
			&lt;source code /&gt;
		</a>
	</footer>
</Layout>
