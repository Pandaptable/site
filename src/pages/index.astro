---
import Card from "../components/card.astro";
import Ads from "../components/cards/ads.astro";
import Buttons from "../components/cards/buttons.astro";
import Profile from "../components/cards/profile.astro";
import Tabs from "../components/cards/tabs.astro";
import Layout from "../layouts/layout.astro";
import "../styles/global.css";
---

<Layout>
	<main class="mx-auto max-w-7xl px-4 py-4 grid gap-3 lg:min-h-dvh lg:content-center lg:items-start lg:grid-cols-[22rem_minmax(0,1fr)]">
		<div class="lg:self-stretch flex flex-col gap-3 min-w-0">
			<Profile />
			<Ads />
		</div>
		<div class="lg:self-stretch flex flex-col gap-3 min-w-0">
			<Tabs />
		</div>
		<Card class="lg:col-span-2">
			<Buttons />
		</Card>
	</main>
	<footer class="fixed bottom-4 right-4 z-50">
		<a
			href="https://github.com/Pandaptable/site"
			target="_blank"
			rel="noopener"
			class="text-ctp-subtext0 hover:text-ctp-mauve transition-colors text-sm font-mono"
		>
			&lt;source code /&gt;
		</a>
	</footer>
</Layout>
