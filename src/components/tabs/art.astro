---
import manifest from "../../../generated/manifest.json";
import { readAssetMetadata } from "../../lib/metadata";

type Entry = { w: number; h: number; c: string; a: boolean; f: string[] };
const entries = manifest as Record<string, Entry>;

const url = (name: string, ext: string) =>
	`/art/${encodeURIComponent(name)}.${ext}`;

const pieces: {
	name: string;
	animated: boolean;
	jxl: string;
	avif: string;
	webp: string;
	jpg: string;
	w?: number;
	h?: number;
	skel: string;
	artist?: string;
	url?: string;
}[] = [];

for (const key of Object.keys(entries)) {
	if (!key.startsWith("art/")) continue;
	const name = key.slice(4);
	const m = entries[key];
	const has = (ext: string) => m.f.includes(ext);
	const credit = await readAssetMetadata(name, { dir: "public/art" });
	pieces.push({
		name,
		animated: m.a,
		jxl: has("jxl") ? url(name, "jxl") : "",
		avif: has("avif") ? url(name, "avif") : "",
		webp: has("webp") ? url(name, "webp") : "",
		jpg: url(
			name,
			["gif", "jpg", "png", "avif"].find((e) => has(e)) ?? "jpg",
		),
		w: m.w,
		h: m.h,
		skel: m.c,
		artist: credit.artist,
		url: credit.url,
	});
}

const art = pieces.sort((a, b) => a.name.localeCompare(b.name));
---

<div class="gallery not-prose mx-auto w-full max-w-[42rem] columns-2 md:columns-3 gap-3">
	{art.map((a) => (
		<div class="group mb-3 break-inside-avoid">
			<button
				type="button"
				data-lightbox={a.jxl}
				data-lightbox-avif={a.avif}
				data-lightbox-webp={a.webp}
				data-lightbox-jpg={a.jpg}
				data-caption={a.name}
				data-artist={a.artist ?? ""}
				data-artist-url={a.url ?? ""}
				class="block w-full cursor-zoom-in border-0 bg-transparent p-0"
			>
				<div class="overflow-hidden rounded-lg border border-transparent transition-colors hover:border-ctp-mauve">
					<picture>
						{a.animated ? (
							<>
								<source srcset={a.avif} type="image/avif" />
								{a.jxl && (
									<source srcset={a.jxl} type="image/jxl" />
								)}
								<source srcset={a.webp} type="image/webp" />
							</>
						) : (
							<>
								{a.jxl && (
									<source srcset={a.jxl} type="image/jxl" />
								)}
								<source srcset={a.avif} type="image/avif" />
								<source srcset={a.webp} type="image/webp" />
							</>
						)}
						<img
							src={a.jpg}
							alt={a.name}
							data-image-component
							loading="eager"
							decoding="async"
							width={a.w}
							height={a.h}
							style={`--skel:${a.skel}`}
							onload="this.classList.add('img-loaded')"
							class="h-auto w-full"
						/>
					</picture>
				</div>
			</button>
			<p class="m-0 mt-1 text-center text-xs text-ctp-subtext0">
				{a.url && !a.artist ? (
					<a
						href={a.url}
						target="_blank"
						rel="noopener noreferrer"
						class="text-ctp-mauve underline decoration-ctp-mauve/40 hover:decoration-ctp-mauve"
					>
						{a.name}
					</a>
				) : (
					a.name
				)}
				{a.artist && (
					<span>
						{" "}
						— by{" "}
						{a.url ? (
							<a
								href={a.url}
								target="_blank"
								rel="noopener noreferrer"
								class="text-ctp-mauve underline decoration-ctp-mauve/40 hover:decoration-ctp-mauve"
							>
								{a.artist}
							</a>
						) : (
							<span>{a.artist}</span>
						)}
					</span>
				)}
			</p>
		</div>
	))}
</div>

<script>
	const gallery = document.querySelector(".gallery");
	if (gallery) {
		const children = [...gallery.children];
		for (let i = children.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1));
			[children[i], children[j]] = [children[j], children[i]];
		}
		children.forEach((child) => gallery.appendChild(child));
	}
</script>

<style>
	@media (min-width: 1024px) and (max-height: 800px) {
		.gallery {
			max-width: 36rem;
		}
	}
</style>
