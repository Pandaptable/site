---
import { readAssetMetadata } from "../../lib/metadata";
import manifest from "../../../generated/manifest.json";

const dim = (key: string) =>
	(manifest as Record<string, { w: number; h: number; c: string }>)[key];
const sources = {
	jxl: import.meta.glob<string>("../../../generated/art/*.jxl", {
		eager: true,
		query: "?url",
		import: "default",
	}),
	avif: import.meta.glob<string>("../../../generated/art/*.avif", {
		eager: true,
		query: "?url",
		import: "default",
	}),
	webp: import.meta.glob<string>("../../../generated/art/*.webp", {
		eager: true,
		query: "?url",
		import: "default",
	}),
	jpg: import.meta.glob<string>("../../../generated/art/*.jpg", {
		eager: true,
		query: "?url",
		import: "default",
	}),
	gif: import.meta.glob<string>("../../../generated/art/*.gif", {
		eager: true,
		query: "?url",
		import: "default",
	}),
	png: import.meta.glob<string>("../../../generated/art/*.png", {
		eager: true,
		query: "?url",
		import: "default",
	}),
};
const animated = new Set(
	Object.keys(
		import.meta.glob("../../../generated/art/*.anim", {
			eager: true,
			query: "?url",
			import: "default",
		}),
	).map((p) => p.split("/").pop()?.replace(/\.[^.]+$/, "") ?? ""),
);


const names = new Set(
	Object.values(sources).flatMap((mods) =>
		Object.keys(mods).map((p) => p.split("/").pop()?.replace(/\.[^.]+$/, "") ?? ""),
	),
);

const pieces: {
	name: string;
	jxl: string;
	avif: string;
	webp: string;
	jpg: string;
	artist?: string;
	url?: string;
}[] = [];

const byName = (mods: Record<string, string>) => {
	const map = new Map<string, string>();
	for (const [p, url] of Object.entries(mods)) {
		const base = p.split("/").pop()?.replace(/\.[^.]+$/, "") ?? "";
		map.set(base, url);
	}
	return map;
};

const maps = {
	jxl: byName(sources.jxl),
	avif: byName(sources.avif),
	webp: byName(sources.webp),
	jpg: byName(sources.jpg),
	png: byName(sources.png),
	gif: byName(sources.gif),
};

for (const name of [...names].filter(Boolean)) {
	const credit = await readAssetMetadata(name, {
		generated: "generated/art",
		src: "src/assets/art",
	});
	pieces.push({
		name,
		jxl: maps.jxl.get(name) ?? "",
		avif: maps.avif.get(name) ?? "",
		webp: maps.webp.get(name) ?? "",
		jpg: maps.gif.get(name) ?? maps.jpg.get(name) ?? maps.png.get(name) ?? "",
		artist: credit.artist,
		url: credit.url,
	});
}

const art = pieces.sort((a, b) => a.name.localeCompare(b.name));
---

<div class="gallery not-prose mx-auto w-full max-w-[42rem] columns-2 md:columns-3 gap-3">
	{
		art.map((a) => (
			<div class="group mb-3 break-inside-avoid">
				<button
					type="button"
					data-lightbox={a.jxl}
					data-lightbox-avif={a.avif}
					data-lightbox-webp={a.webp}
					data-lightbox-jpg={a.jpg}
					data-caption={a.name}
					data-artist={a.artist ?? ""}
					data-artist-url={a.url ?? ""}
					class="block w-full cursor-zoom-in border-0 bg-transparent p-0"
				>
					<div class="overflow-hidden rounded-lg border border-ctp-surface1 transition-colors group-hover:border-ctp-mauve">
						<picture>
							{animated.has(a.name) ? (
								<>
									<source srcset={a.avif} type="image/avif" />
									{a.jxl && <source srcset={a.jxl} type="image/jxl" />}
									<source srcset={a.webp} type="image/webp" />
								</>
							) : (
								<>
									{a.jxl && <source srcset={a.jxl} type="image/jxl" />}
									<source srcset={a.avif} type="image/avif" />
									<source srcset={a.webp} type="image/webp" />
								</>
							)}
						<img
							src={a.jpg}
							alt={a.name}
							data-image-component
							loading="lazy"
							decoding="async"
							width={dim(`art/${a.name}`)?.w}
							height={dim(`art/${a.name}`)?.h}
							style={`--skel:${dim(`art/${a.name}`)?.c ?? "transparent"}`}
							onload="this.classList.add('img-loaded')"
							class="h-auto w-full"
						/>
						</picture>
					</div>
				</button>
			<p class="m-0 mt-1 text-center text-xs text-ctp-subtext0">
				{a.url && !a.artist ? (
					<a
						href={a.url}
						target="_blank"
						rel="noopener noreferrer"
						class="text-ctp-mauve underline decoration-ctp-mauve/40 hover:decoration-ctp-mauve"
					>
						{a.name}
					</a>
				) : (
					a.name
				)}
				{a.artist && (
					<span>
						{" "}
						— by{" "}
						{a.url ? (
							<a
								href={a.url}
								target="_blank"
								rel="noopener noreferrer"
								class="text-ctp-mauve underline decoration-ctp-mauve/40 hover:decoration-ctp-mauve"
							>
								{a.artist}
							</a>
						) : (
							<span>{a.artist}</span>
						)}
					</span>
				)}
			</p>
			</div>
		))
	}
</div>

<style>
	@media (min-width: 1024px) and (max-height: 800px) {
		.gallery {
			max-width: 36rem;
		}
	}
</style>
