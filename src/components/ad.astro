---
interface Props {
	src: string;
	link?: string;
	active?: boolean;
}

const { src, link, active = false } = Astro.props;
const name = src.replace(/\.[^.]+$/, "");
const animated = /\.(gif|avif)$/i.test(src);
const u = (e: string) => `/ads/${encodeURIComponent(name)}.${e}`;
const fallback = animated ? u("gif") : u("jpg");
---

<a
	class:list={["billboard", active && "billboard-on"]}
	href={link}
	target={link ? "_blank" : undefined}
	rel={link ? "noopener noreferrer" : undefined}
	data-spot={name}
>
	<picture>
		<source srcset={u("avif")} type="image/avif" />
		{animated && <source srcset={u("jxl")} type="image/jxl" />}
		<source srcset={u("webp")} type="image/webp" />
		<img
			src={fallback}
			alt={name}
			data-image-component
			loading="eager"
			decoding="async"
			onload="this.classList.add('img-loaded')"
			class="h-full w-full object-cover"
		/>
	</picture>
</a>
