---
import { Icon } from "astro-icon/components";
import Card from "../components/card.astro";
---

<Card
	href="https://github.com/Pandaptable"
	class="row-span-1 col-span-1 flex flex-col items-center justify-center text-center isolate"
	aria-label="GitHub"
>
	<Icon
		name="mdi:github"
		class="w-14 h-14 sm:w-20 sm:h-20 md:w-24 md:h-24 text-ctp-mauve"
		aria-label="GitHub"
	/>
</Card>
<Card
	href="https://osm.pm/@nemmy"
	class="row-span-1 col-span-1 flex flex-col items-center justify-center text-center isolate"
	aria-label="Osmium"
>
	<svg
		xmlns="http://www.w3.org/2000/svg"
		fill="currentColor"
		viewBox="0 0 512 512"
		class="w-14 h-14 sm:w-20 sm:h-20 md:w-22 md:h-22 text-ctp-mauve"
		role="img"
		aria-label="Osmium"
	>
		<path
			d="M461 321 167 151 349 46 281 7a51 51 0 0 0-50 0L51 111a47 47 0 0 0 0 80l294 170-182 105 68 39a51 51 0 0 0 50 0l180-104a47 47 0 0 0 0-80Z"
		></path>
		<path
			d="m203 382-82-48v-42l-93-54v121c0 18 9 35 25 44l57 33 93-54Zm256-273-57-33-94 54 83 48v42l93 54V153c0-18-9-35-25-44Z"
		></path>
	</svg>
</Card>
<Card
	href="https://discord.com/users/97153209843335168"
	class="row-span-1 col-span-1 flex flex-col items-center justify-center text-center isolate"
	aria-label="Discord"
>
	<Icon
		name="ic:baseline-discord"
		class="w-14 h-14 sm:w-20 sm:h-20 md:w-24 md:h-24 text-ctp-mauve"
		aria-label="Discord"
	/>
</Card>
<Card
	href="https://steamcommunity.com/profiles/76561198180397682/"
	class="row-span-1 col-span-1 flex flex-col items-center justify-center text-center isolate"
	aria-label="Steam"
>
	<Icon
		name="mdi:steam"
		class="w-14 h-14 sm:w-20 sm:h-20 md:w-24 md:h-24 text-ctp-mauve"
		aria-label="Steam"
	/>
</Card>
<Card
	href="https://www.youtube.com/@Pandaptable"
	class="row-span-1 col-span-1 flex flex-col items-center justify-center text-center isolate"
	aria-label="YouTube"
>
	<Icon
		name="mdi:youtube"
		class="w-14 h-14 sm:w-20 sm:h-20 md:w-24 md:h-24 text-ctp-mauve"
		aria-label="YouTube"
	/>
</Card>
<Card
	href="https://www.twitch.tv/Pandaptable_"
	class="row-span-1 col-span-1 flex flex-col items-center justify-center text-center isolate"
	aria-label="Twitch"
>
	<Icon
		name="mdi:twitch"
		class="w-14 h-14 sm:w-20 sm:h-20 md:w-24 md:h-24 text-ctp-mauve"
		aria-label="Twitch"
	/>
</Card>
<Card
	href="https://twitter.com/Pandaptable_"
	class="row-span-1 col-span-1 flex flex-col items-center justify-center text-center isolate"
	aria-label="Twitter"
>
	<svg
		xmlns="http://www.w3.org/2000/svg"
		fill="currentColor"
		viewBox="0 0 24 24"
		class="w-14 h-14 sm:w-20 sm:h-20 md:w-24 md:h-24 text-ctp-mauve"
		role="img"
		aria-label="Twitter"
	>
		<path
			d="M22.46 6c-.77.35-1.6.58-2.46.69c.88-.53 1.56-1.37 1.88-2.38c-.83.5-1.75.85-2.72 1.05C18.37 4.5 17.26 4 16 4c-2.35 0-4.27 1.92-4.27 4.29c0 .34.04.67.11.98C8.28 9.09 5.11 7.38 3 4.79c-.37.63-.58 1.37-.58 2.15c0 1.49.75 2.81 1.91 3.56c-.71 0-1.37-.2-1.95-.5v.03c0 2.08 1.48 3.82 3.44 4.21a4.2 4.2 0 0 1-1.93.07a4.28 4.28 0 0 0 4 2.98a8.52 8.52 0 0 1-5.33 1.84q-.51 0-1.02-.06C3.44 20.29 5.7 21 8.12 21C16 21 20.33 14.46 20.33 8.79c0-.19 0-.37-.01-.56c.84-.6 1.56-1.36 2.14-2.23"
		></path>
	</svg>
</Card>
<Card
	href="https://bsky.app/profile/pandaptable.moe"
	class="row-span-1 col-span-1 flex flex-col items-center justify-center text-center isolate"
	aria-label="Bluesky"
>
	<svg
		xmlns="http://www.w3.org/2000/svg"
		fill="currentColor"
		viewBox="0 0 16 16"
		class="w-14 h-14 sm:w-20 sm:h-20 md:w-24 md:h-24 text-ctp-mauve"
		role="img"
		aria-label="Bluesky"
	>
		<path
			d="M3.468 1.948C5.303 3.325 7.276 6.118 8 7.616c.725-1.498 2.698-4.29 4.532-5.668C13.855.955 16 .186 16 2.632c0 .489-.28 4.105-.444 4.692-.572 2.04-2.653 2.561-4.504 2.246 3.236.551 4.06 2.375 2.281 4.2-3.376 3.464-4.852-.87-5.23-1.98-.07-.204-.103-.3-.103-.218 0-.081-.033.014-.102.218-.379 1.11-1.855 5.444-5.231 1.98-1.778-1.825-.955-3.65 2.28-4.2-1.85.315-3.932-.205-4.503-2.246C.28 6.737 0 3.12 0 2.632 0 .186 2.145.955 3.468 1.948"
		></path>
	</svg>
</Card>
