---
const { class: className, title, href, ...rest } = Astro.props;
const Element = href ? "a" : "div";
---

<Element
	href={href}
	class={`mt-3 sm:mt-4 bg-ctp-mantle border border-ctp-surface1 rounded-2xl p-4 sm:p-6 shadow-sm hover:border-ctp-mauve transition-colors block no-underline ${className || ""}`}
	{...rest}
>
	{
		title && (
			<div class="border-b border-ctp-surface1 pb-3 mb-4">
				<h2 class="text-lg font-semibold text-ctp-text">{title}</h2>
			</div>
		)
	}

	<slot />
</Element>
