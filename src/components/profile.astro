---
import { Icon } from "astro-icon/components";
import Card from "../components/card.astro";
import "../styles/profile.css";
---

<Card class="flex flex-col items-center text-center">
	<div class="profile-avatar-wrapper">
		<picture>
			<source srcset="/art/pfp.avif" type="image/avif" />
			<source srcset="/art/pfp.webp" type="image/webp" />
			<img
				src="/art/pfp.jpg"
				alt="pfp"
				data-image-component
				class="w-28 h-28 rounded-full lg:w-48 lg:h-48"
				loading="eager"
				fetchpriority="high"
				onload="this.classList.add('img-loaded')"
			/>
		</picture>
		<span class="discord-color-dot"></span>
	</div>
	<div class="flex items-center justify-center gap-2 mt-2">
		<h1 class="text-ctp-text text-2xl font-bold">nemmy</h1>
		<span class="bg-ctp-mauve-500 text-ctp-base text-sm font-black px-2.5 py-0.5 rounded-full">
			she/her
		</span>
	</div>
	<p class="text-base font-bold text-ctp-subtext1 mt-1 mb-2">
		%%AGE%% y/o cat raccoon panda thing...
	</p>

	<div class="discord-rpc rpc-idle">
		<button
			class="discord-nav discord-nav-left"
			style="display: none;"
			aria-label="Previous activity"
		>
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				width="12"
				height="12"
			>
				<polyline points="15 18 9 12 15 6"></polyline>
			</svg>
		</button>
		<button
			class="discord-nav discord-nav-right"
			style="display: none;"
			aria-label="Next activity"
		>
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				width="12"
				height="12"
			>
				<polyline points="9 6 15 12 9 18"></polyline>
			</svg>
		</button>
		<div class="discord-rpc-content">
			<div class="discord-rpc-images" style="visibility: hidden;">
				<svg
					class="discord-image-container"
					viewBox="0 0 160 160"
					width="56"
					height="56"
				>
					<defs>
						<mask id="mask-large-image">
							<rect
								fill="white"
								x="0"
								y="0"
								width="160"
								height="160"
								rx="16"
							></rect>
							<circle
								fill="black"
								cx="141"
								cy="141"
								r="27"
							></circle>
						</mask>
					</defs>
					<foreignObject x="0" y="0" width="160" height="160" rx="16">
						<div class="discord-large-image"></div>
					</foreignObject>
				</svg>
				<div class="discord-small-image"></div>
			</div>
			<div class="discord-rpc-info">
				<span class="discord-status-text"></span>
				<span class="discord-activity">
					<span class="rpc-text rpc-static-error">ERROR</span>
				</span>
				<span class="discord-details">
					<span class="rpc-text rpc-static-hint">
						enable javascript for an optimal experience
					</span>
				</span>
				<span class="discord-state">
					<span class="rpc-text"></span>
				</span>
				<span class="discord-timestamp"></span>
			</div>
		</div>
		<div class="rpc-error"></div>
		<div class="discord-progress" style="display: none;">
			<div class="discord-progress-bar"></div>
		</div>
	</div>

	<div class="socials-grid">
		<a
			href="https://github.com/Pandaptable"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="GitHub"
			title="GitHub"
		>
			<Icon name="mdi:github" />
		</a>
		<a
			href="https://osm.pm/@nem"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Osmium"
			title="Osmium"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				fill="currentColor"
				viewBox="0 0 512 512"
				role="img"
				aria-label="Osmium"
			>
				<path d="M461 321 167 151 349 46 281 7a51 51 0 0 0-50 0L51 111a47 47 0 0 0 0 80l294 170-182 105 68 39a51 51 0 0 0 50 0l180-104a47 47 0 0 0 0-80Z"></path>
				<path d="m203 382-82-48v-42l-93-54v121c0 18 9 35 25 44l57 33 93-54Zm256-273-57-33-94 54 83 48v42l93 54V153c0-18-9-35-25-44Z"></path>
			</svg>
		</a>
		<a
			href="https://discord.com/users/97153209843335168"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Discord"
			title="Discord"
		>
			<Icon name="ic:baseline-discord" />
		</a>
		<a
			href="https://steamcommunity.com/profiles/76561198180397682/"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Steam"
			title="Steam"
		>
			<Icon name="mdi:steam" />
		</a>
		<a
			href="https://www.youtube.com/@Pandaptable"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="YouTube"
			title="YouTube"
		>
			<Icon name="mdi:youtube" />
		</a>
		<a
			href="https://www.twitch.tv/Pandaptable_"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Twitch"
			title="Twitch"
		>
			<Icon name="mdi:twitch" />
		</a>
		<a
			href="https://twitter.com/Pandaptable_"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Twitter"
			title="Twitter"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				fill="currentColor"
				viewBox="0 0 24 24"
				role="img"
				aria-label="Twitter"
			>
				<path d="M22.46 6c-.77.35-1.6.58-2.46.69c.88-.53 1.56-1.37 1.88-2.38c-.83.5-1.75.85-2.72 1.05C18.37 4.5 17.26 4 16 4c-2.35 0-4.27 1.92-4.27 4.29c0 .34.04.67.11.98C8.28 9.09 5.11 7.38 3 4.79c-.37.63-.58 1.37-.58 2.15c0 1.49.75 2.81 1.91 3.56c-.71 0-1.37-.2-1.95-.5v.03c0 2.08 1.48 3.82 3.44 4.21a4.2 4.2 0 0 1-1.93.07a4.28 4.28 0 0 0 4 2.98a8.52 8.52 0 0 1-5.33 1.84q-.51 0-1.02-.06C3.44 20.29 5.7 21 8.12 21C16 21 20.33 14.46 20.33 8.79c0-.19 0-.37-.01-.56c.84-.6 1.56-1.36 2.14-2.23"></path>
			</svg>
		</a>
		<a
			href="https://bsky.app/profile/pandaptable.moe"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Bluesky"
			title="Bluesky"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				fill="currentColor"
				viewBox="0 0 16 16"
				role="img"
				aria-label="Bluesky"
			>
				<path d="M3.468 1.948C5.303 3.325 7.276 6.118 8 7.616c.725-1.498 2.698-4.29 4.532-5.668C13.855.955 16 .186 16 2.632c0 .489-.28 4.105-.444 4.692-.572 2.04-2.653 2.561-4.504 2.246 3.236.551 4.06 2.375 2.281 4.2-3.376 3.464-4.852-.87-5.23-1.98-.07-.204-.103-.3-.103-.218 0-.081-.033.014-.102.218-.379 1.11-1.855 5.444-5.231 1.98-1.778-1.825-.955-3.65 2.28-4.2-1.85.315-3.932-.205-4.503-2.246C.28 6.737 0 3.12 0 2.632 0 .186 2.145.955 3.468 1.948"></path>
			</svg>
		</a>
	</div>
</Card>

<script>
	for (const link of document.querySelectorAll<HTMLElement>(
		".socials-grid a",
	)) {
		link.addEventListener("pointerenter", () => {
			link.style.setProperty(
				"--tilt",
				`${(Math.random() * 10 - 5).toFixed(2)}deg`,
			);
		});
	}
</script>

<script src="../scripts/lanyard.ts"></script>
