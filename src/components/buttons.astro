---
import { Image } from "astro:assets";
---

<div class="flex flex-wrap gap-1" id="buttons-container">
	<div class="relative group w-22 h-7.75">
		<a
			href="https://pandaptable.moe"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="pandaptable.moe"
		>
			<Image
				src="/buttons/button.avif"
				width={88}
				height={31}
				alt="pandaptable.moe"
				loading="eager"
				fetchpriority="low"
			/>
		</a>

		<button
			id="copy-btn"
			class="absolute inset-0 z-10 flex items-center justify-center bg-black/75 text-white text-xs font-bold opacity-0 transition-opacity duration-200 group-hover:opacity-100 cursor-pointer rounded-sm"
			data-url="https://pandaptable.moe"
			title="Copy URL"
		>
			Copy
		</button>
	</div>
	<a
		href="https://mauve.beer"
		target="_blank"
		rel="noopener noreferrer"
		aria-label="mauve"
	>
		<Image
			src="https://lumap.xyz/button.png"
			width={88}
			height={31}
			alt="mauve"
			loading="eager"
			fetchpriority="low"
		/>
	</a>
	<a
		href="https://emerald.moe"
		target="_blank"
		rel="noopener noreferrer"
		aria-label="emerald"
	>
		<img
			src="/buttons/emerald.svg"
			width={88}
			height={31}
			alt="emerald"
			loading="eager"
			fetchpriority="low"
		/>
	</a>
	<a
		href="https://azee.sh"
		target="_blank"
		rel="noopener noreferrer"
		aria-label="azee"
	>
		<Image
			src="https://azee.sh/images/web-badge.gif"
			width={88}
			height={31}
			alt="azee"
			loading="eager"
			fetchpriority="low"
		/>
	</a>
	<a
		href="https://slonk.ing"
		target="_blank"
		rel="noopener noreferrer"
		aria-label="slonk ;3"
	>
		<Image
			src="https://slonk.ing/img/88x31.webp"
			width={88}
			height={31}
			alt="slonk ;3"
			loading="eager"
			fetchpriority="low"
		/>
	</a>
	<a
		href="https://byeoon.dev/"
		target="_blank"
		rel="noopener noreferrer"
		aria-label="byeoon"
	>
		<Image
			src="https://byeoon.dev/img/button.png"
			width={88}
			height={31}
			alt="byeoon"
			loading="eager"
			fetchpriority="low"
		/>
	</a>
	<a
		href="steam://open/console"
		target="_blank"
		rel="noopener noreferrer"
		aria-label="mmmfffhgggg valve,,,"
	>
		<Image
			src="/buttons/steam.gif"
			width={88}
			height={31}
			alt="mmmfffhgggg valve,,,"
			loading="eager"
			fetchpriority="low"
		/>
	</a>
	<a
		href="steam://launch/70"
		target="_blank"
		rel="noopener noreferrer"
		aria-label="hl1 is the best half life."
	>
		<Image
			src="/buttons/newlambda.gif"
			width={88}
			height={31}
			alt="hl1 is the best half life."
			loading="eager"
			fetchpriority="low"
		/>
	</a>
	<Image
		src="/buttons/hellokitty.gif"
		width={88}
		height={31}
		alt="haiiiii ;3"
		loading="eager"
		fetchpriority="low"
	/>
</div>

<script>
	for (const img of document.querySelectorAll<HTMLImageElement>(
		"img[data-image-component]",
	)) {
		if (img.complete) img.classList.add("img-loaded");
		else
			img.addEventListener(
				"load",
				() => img.classList.add("img-loaded"),
				{
					once: true,
				},
			);
	}
</script>

<script>
	const container = document.getElementById("buttons-container");
	if (container) {
		const children = [...container.children];
		for (let i = children.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1));
			[children[i], children[j]] = [children[j], children[i]];
		}
		const own = children.splice(
			children.findIndex(
				(c) => c.id === "copy-btn" || c.querySelector?.("#copy-btn"),
			),
			1,
		);
		children.unshift(...own);
		children.forEach((child) => container.appendChild(child));

		for (const btn of container.children as HTMLCollectionOf<HTMLElement>) {
			btn.addEventListener("pointerenter", () => {
				btn.style.setProperty(
					"--tilt",
					`${(Math.random() * 8 - 4).toFixed(2)}deg`,
				);
				btn.style.setProperty(
					"--grow",
					(1.08 + Math.random() * 0.16).toFixed(3),
				);
			});
		}
	}

	const copyBtn = document.getElementById("copy-btn");

	if (copyBtn) {
		copyBtn.addEventListener("click", async (e) => {
			e.preventDefault();
			e.stopPropagation();

			const copyText = `<a href="https://pandaptable.moe"><img src="https://pandaptable.moe/buttons/button.avif" width="88" height="31" alt="88x31 button"></a>`;

			if (copyText) {
				try {
					await navigator.clipboard.writeText(copyText);

					copyBtn.innerText = "Copied!";
					copyBtn.classList.add("text-green-400");

					setTimeout(() => {
						copyBtn.innerText = "Copy";
						copyBtn.classList.remove("text-green-400");
					}, 2000);
				} catch (err) {
					console.error("Failed to copy url: ", err);
				}
			}
		});
	}
</script>

<style is:global>
	#buttons-container > * {
		position: relative;
		transition:
			transform 0.15s ease,
			z-index 0s;
	}

	#buttons-container > *:hover {
		transform: scale(var(--grow, 1.18)) rotate(var(--tilt, -3deg));
		z-index: 30;
	}

	@media (prefers-reduced-motion: reduce) {
		#buttons-container > *:hover {
			transform: none;
		}
	}
</style>
