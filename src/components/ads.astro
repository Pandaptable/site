---
import manifest from "../../generated/manifest.json";
import { readAssetMetadata } from "../lib/metadata";

type Entry = { w: number; h: number; c: string; a: boolean; f: string[] };
const entries = manifest as Record<string, Entry>;

const url = (name: string, ext: string) =>
	`/ads/${encodeURIComponent(name)}.${ext}`;

const ads = (
	await Promise.all(
		Object.keys(entries)
			.filter((k) => k.startsWith("ads/"))
			.map(async (key) => {
				const name = key.slice(4);
				const m = entries[key];
				const has = (ext: string) => m.f.includes(ext);
				const meta = await readAssetMetadata(name, {
					dir: "public/ads",
				});
				return {
					name,
					animated: m.a,
					jxl: has("jxl") ? url(name, "jxl") : "",
					avif: has("avif") ? url(name, "avif") : "",
					webp: has("webp") ? url(name, "webp") : "",
					fallback: url(
						name,
						["gif", "jpg", "png"].find((e) => has(e)) ?? "gif",
					),
					skel: m.c,
					url: meta.url ?? "",
				};
			}),
	)
).sort((a, b) => a.name.localeCompare(b.name));
---

<div class="billboard-frame aspect-[12/5] lg:mt-auto relative rounded-xl border border-ctp-surface1 bg-ctp-mantle shadow-sm hover:border-ctp-mauve transition-colors overflow-hidden p-0.5">
	{ads.map((a, i) => (
		<a
			class="billboard"
			href={a.url || undefined}
			target="_blank"
			rel="noopener noreferrer"
			data-spot={a.name}
			class:list={[i === 0 && "billboard-on"]}
		>
			<picture>
				{a.animated ? (
					<>
						<source srcset={a.avif} type="image/avif" />
						{a.jxl && <source srcset={a.jxl} type="image/jxl" />}
						<source srcset={a.webp} type="image/webp" />
					</>
				) : (
					<>
						{a.jxl && <source srcset={a.jxl} type="image/jxl" />}
						<source srcset={a.avif} type="image/avif" />
						<source srcset={a.webp} type="image/webp" />
					</>
				)}
				<img
					src={a.fallback}
					alt={`billboard: ${a.name}`}
					data-image-component
					loading="eager"
					decoding="async"
					style={`--skel:${a.skel}`}
					onload="this.classList.add('img-loaded')"
					class="h-full w-full object-cover"
				/>
			</picture>
		</a>
	))}
</div>

<style is:global>
	.billboard {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		border-radius: 0.375rem;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.4s ease;
	}

	.billboard picture {
		display: contents;
	}

	.billboard-on {
		opacity: 1;
		pointer-events: auto;
		z-index: 1;
	}
</style>

<script src="../scripts/ads.ts"></script>
