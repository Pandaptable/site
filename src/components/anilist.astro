---
import Card from "./card.astro";
---

<Card
	title="AniList"
	href="https://anilist.co/user/Pandaptable/"
	class="row-span-2 col-span-2 md:col-span-4"
>
	<div class="anilist-carousel" id="anilist-carousel">
		<button
			id="anilist-prev"
			class="anilist-nav-btn anilist-nav-prev"
			aria-label="Previous activities"
			disabled
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d="m15 18-6-6 6-6"></path>
			</svg>
		</button>

		<div class="anilist-grid" id="anilist-grid">
			{
				Array.from({ length: 4 }).map(() => (
					<div class="anilist-activity anilist-skeleton">
						<div class="anilist-cover" />
						<div class="anilist-info">
							<span class="anilist-title skeleton-line" />
							<span class="anilist-status skeleton-line short" />
							<span class="anilist-time skeleton-line shorter" />
						</div>
					</div>
				))
			}
		</div>

		<button
			id="anilist-next"
			class="anilist-nav-btn anilist-nav-next"
			aria-label="Next activities"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d="m9 18 6-6-6-6"></path>
			</svg>
		</button>
	</div>
</Card>

<script>
	const ANILIST_USER_ID = 713317;
	let currentPage = 1;
	let isFetching = false;

	const TIME_UNITS: [string, number][] = [
		["year", 31536000],
		["month", 2592000],
		["week", 604800],
		["day", 86400],
		["hour", 3600],
		["minute", 60],
		["second", 1],
	];

	function relativeTime(timestamp: number): string {
		const diff = Math.floor(Date.now() / 1000) - timestamp;
		for (const [unit, value] of TIME_UNITS) {
			const amount = Math.floor(diff / value);
			if (amount > 0)
				return `${amount} ${unit}${amount > 1 ? "s" : ""} ago`;
		}
		return "just now";
	}

	function formatStatus(activity: any): string {
		const raw = `${activity.status}${activity.progress ? ` ${activity.progress}` : ""}`;
		return raw.charAt(0).toUpperCase() + raw.slice(1);
	}

	async function loadAniList(page: number = 1) {
		if (isFetching) return;
		isFetching = true;

		const carousel = document.getElementById("anilist-carousel");
		const grid = document.getElementById("anilist-grid");
		const prevBtn = document.getElementById(
			"anilist-prev",
		) as HTMLButtonElement | null;
		const nextBtn = document.getElementById(
			"anilist-next",
		) as HTMLButtonElement | null;

		if (!grid) return;

		if (page > 1) grid.style.opacity = "0.5";

		const query = `query {
			Page(page: ${page}, perPage: 4) {
				pageInfo {
					hasNextPage
				}
				activities(userId: ${ANILIST_USER_ID}, sort: ID_DESC) {
					... on ListActivity {
						createdAt
						status
						progress
						media {
							coverImage {
								medium
							}
							title {
								english
								romaji
							}
							siteUrl
						}
					}
				}
			}
		}`;

		try {
			const res = await fetch("https://graphql.anilist.co", {
				method: "POST",
				headers: { "content-type": "application/json" },
				body: JSON.stringify({ query }),
			}).then((r) => r.json());

			if (!res.data) return;

			const pageInfo = res.data.Page.pageInfo;
			const activities = res.data.Page.activities.filter(
				(a: any) => a.media,
			);

			grid.innerHTML = activities
				.map(
					(activity: any) => `
				<a href="${activity.media.siteUrl}" target="_blank" rel="noopener noreferrer" class="anilist-activity">
					<div class="anilist-cover" style="background-image: url(${activity.media.coverImage.medium})"></div>
					<div class="anilist-info">
						<span class="anilist-title">${activity.media.title.english || activity.media.title.romaji}</span>
						<span class="anilist-status">${formatStatus(activity)}</span>
						<time class="anilist-time"
							data-timestamp="${activity.createdAt}"
							datetime="${new Date(activity.createdAt * 1000).toISOString()}"
							title="${new Date(activity.createdAt * 1000).toLocaleString()}">
							${relativeTime(activity.createdAt)}
						</time>
					</div>
				</a>`,
				)
				.join("");

			if (prevBtn) prevBtn.disabled = page === 1;
			if (nextBtn) nextBtn.disabled = !pageInfo.hasNextPage;
		} catch (e) {
			console.error("Failed to fetch AniList data:", e);
		} finally {
			grid.style.opacity = "1";
			isFetching = false;
		}
	}

	function updateTimes() {
		document
			.querySelectorAll<HTMLTimeElement>(".anilist-time[data-timestamp]")
			.forEach((el) => {
				const timestamp = parseInt(el.dataset.timestamp || "0", 10);
				el.textContent = relativeTime(timestamp);
			});
	}

	document.getElementById("anilist-prev")?.addEventListener("click", (e) => {
		e.preventDefault();
		e.stopPropagation();
		if (currentPage > 1) {
			currentPage--;
			loadAniList(currentPage);
		}
	});

	document.getElementById("anilist-next")?.addEventListener("click", (e) => {
		e.preventDefault();
		e.stopPropagation();
		currentPage++;
		loadAniList(currentPage);
	});

	loadAniList(1);
	setInterval(updateTimes, 60000);
</script>

<style is:global>
	.anilist-carousel {
		position: relative;
		width: 100%;
	}

	.anilist-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.75rem;
		transition: opacity 0.2s ease;
	}

	@media (max-width: 640px) {
		.anilist-grid {
			grid-template-columns: 1fr;
		}
	}

	.anilist-activity {
		display: flex;
		gap: 0.75rem;
		padding: 0.625rem;
		border-radius: 0.75rem;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid transparent;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.anilist-activity:hover {
		background: rgba(255, 255, 255, 0.06);
		border-color: var(--color-ctp-mauve);
	}

	.anilist-cover {
		width: 3.5rem;
		height: 5rem;
		min-width: 3.5rem;
		border-radius: 0.5rem;
		background-size: cover;
		background-position: center;
		background-color: var(--color-ctp-surface0);
	}

	.anilist-info {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.25rem;
		min-width: 0;
	}

	.anilist-title {
		color: var(--color-ctp-text);
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1.3;
		overflow: hidden;
		text-overflow: ellipsis;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
	}

	.anilist-status {
		color: var(--color-ctp-mauve);
		font-size: 0.75rem;
		font-weight: 500;
	}

	.anilist-time {
		color: var(--color-ctp-subtext0);
		font-size: 0.6875rem;
	}

	.anilist-skeleton {
		pointer-events: none;
	}

	.skeleton-line {
		display: block;
		height: 0.75rem;
		border-radius: 0.25rem;
		background: var(--color-ctp-surface0);
		animation: skeleton-pulse 1.5s ease-in-out infinite;
	}

	.skeleton-line.short {
		width: 60%;
	}

	.skeleton-line.shorter {
		width: 40%;
	}

	@keyframes skeleton-pulse {
		0%,
		100% {
			opacity: 0.4;
		}
		50% {
			opacity: 0.8;
		}
	}

	.anilist-nav-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background-color: var(--color-ctp-surface0, rgba(255, 255, 255, 0.05));
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: var(--color-ctp-subtext0, #a6adc8);
		cursor: pointer;
		transition:
			all 0.2s ease,
			visibility 0.2s ease,
			opacity 0.2s ease;
		flex-shrink: 0;
		z-index: 10;
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		opacity: 0;
		visibility: hidden;
	}

	.anilist-carousel:hover .anilist-nav-btn {
		opacity: 1;
		visibility: visible;
	}

	.anilist-nav-prev {
		left: -1rem;
	}

	.anilist-nav-next {
		right: -1rem;
	}

	.anilist-nav-btn:hover:not(:disabled) {
		background-color: rgba(255, 255, 255, 0.1);
		color: var(--color-ctp-text, #cdd6f4);
		border-color: var(--color-ctp-mauve);
	}

	.anilist-nav-btn:disabled {
		opacity: 0.3;
		cursor: not-allowed;
	}

	.anilist-nav-btn svg {
		width: 16px;
		height: 16px;
	}
</style>
